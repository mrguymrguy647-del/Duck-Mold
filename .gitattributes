# Every text file keeps Unix line endings on every computer. The tests
# compare what the program prints with stored files byte for byte, and
# on Windows Git would otherwise change the stored files' line endings.
* text=auto eol=lf

# Models and pictures are not text.
*.glb binary
*.png binary
*.ico binary

# The files Windows itself reads keep Windows line endings: the scripts
# to double-click, and the read-me that Notepad opens.
*.bat text eol=crlf
release/*.txt text eol=crlf
